<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The assembly name must not become the root namespace: `Everlong.Nester.Avalonia`
         would then exist as an implicit namespace prefix and shadow the global `Avalonia`
         namespace, so every `Avalonia.X` reference fails with CS0234.  The files declare
         `Everlong.Nester.Tests.*`, so that is the root namespace. -->
    <RootNamespace>Everlong.Nester.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Everlong.Settings" Version="0.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The platform-free test kit the core head owns and this one shares: the
         kit's own types are compiled into both heads, so they are linked rather
         than moved, and only the files a landed suite needs are listed. -->
    <Compile Include="..\Everlong.Nester.Tests\Layer\TestBrokerCore.cs" Link="Kit\Layer\TestBrokerCore.cs" />
    <Compile Include="..\Everlong.Nester.Tests\Layer\TestLease.cs" Link="Kit\Layer\TestLease.cs" />
    <Compile Include="..\Everlong.Nester.Tests\Navigation\ChainBuilder.cs" Link="Kit\Navigation\ChainBuilder.cs" />
    <Compile Include="..\Everlong.Nester.Tests\Routing\Fakes.cs" Link="Kit\Routing\Fakes.cs" />
    <Compile Include="..\Everlong.Nester.Tests\Routing\TestContent.cs" Link="Kit\Routing\TestContent.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The template the shell suites drive: the shared half plus the two
         platform files it needs, linked rather than copied so the application
         under test is the application that ships. -->
    <Compile Include="..\..\examples\Template.Shared\Pages\**\*.cs" Link="Template.Shared\Pages\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\examples\Template.Shared\Dialogs\**\*.cs" Link="Template.Shared\Dialogs\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\examples\Template.Shared\Models\**\*.cs" Link="Template.Shared\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\examples\Template.Shared\Services\**\*.cs" Link="Template.Shared\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\examples\Template.Shared\Hosting\**\*.cs" Link="Template.Shared\Hosting\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\examples\Template.Shared\Properties\**\*.cs" Link="Template.Shared\Properties\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\examples\Template.Avalonia\UiShell.cs" Link="Template.Avalonia\UiShell.cs" />
    <Compile Include="..\..\examples\Template.Avalonia\Pages\Shell\MainViewModel.Avalonia.cs" Link="Template.Avalonia\Pages\Shell\MainViewModel.Avalonia.cs" />
    <!-- The generated locale set is carried, not regenerated: the head has no Elg
         property, and this file is the artifact `dotnet elg gen` already wrote
         for the template's own i18n source. -->
    <Compile Include="..\..\examples\Template.Avalonia\Properties\Lang*.g.cs" Link="Template.Avalonia\Properties\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Everlong.Nester\Everlong.Nester.csproj" />
    <ProjectReference Include="..\..\src\Everlong.Nester.Avalonia\Everlong.Nester.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Everlong.Nester.Extensions.Avalonia\Everlong.Nester.Extensions.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Everlong.Nester.Generators\Everlong.Nester.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
