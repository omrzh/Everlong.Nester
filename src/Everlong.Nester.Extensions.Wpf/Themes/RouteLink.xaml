<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Everlong.Nester.Presentation">

  <Style TargetType="{x:Type v:RouteLink}">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type v:RouteLink}">
          <Border x:Name="LinkBorder"
                  Padding="0"
                  Background="Transparent"
                  CornerRadius="4">
            <Button x:Name="PART_LinkButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <!-- Transparent background keeps the whole area hit-testable -->
                  <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
              <Grid>
                <StackPanel x:Name="DefaultContent"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                  <ContentPresenter x:Name="IconHost"
                                    Content="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type v:RouteLink}}}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0" />
                  <TextBlock x:Name="TitleText"
                             Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type v:RouteLink}}}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <ContentPresenter x:Name="CustomContent"
                                  Content="{Binding Content, RelativeSource={RelativeSource AncestorType={x:Type v:RouteLink}}}"
                                  ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource AncestorType={x:Type v:RouteLink}}}"
                                  HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type v:RouteLink}}}"
                                  VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type v:RouteLink}}}"
                                  Visibility="Collapsed" />
              </Grid>
            </Button>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UseDefaultContent" Value="True">
              <Setter TargetName="DefaultContent" Property="Visibility" Value="Visible" />
              <Setter TargetName="CustomContent" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="UseDefaultContent" Value="False">
              <Setter TargetName="DefaultContent" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CustomContent" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="HasIcon" Value="False">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="LinkBorder" Property="IsMouseOver" Value="True">
              <Setter TargetName="LinkBorder" Property="Background"
                      Value="{DynamicResource Nester.RouteLink.Hover}" />
            </Trigger>
            <Trigger Property="IsActive" Value="True">
              <Setter TargetName="LinkBorder" Property="Background"
                      Value="{DynamicResource Nester.RouteLink.Active.Background}" />
              <Setter Property="Foreground" Value="{DynamicResource Nester.RouteLink.Active.Foreground}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
