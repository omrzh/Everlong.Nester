<UserControl x:Class="Everlong.Nester.Controls.NumpadDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:c="clr-namespace:Everlong.Nester.Dialog;assembly=Everlong.Nester.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="660"
             d:DesignWidth="430"
             d:DataContext="{d:DesignInstance c:NumpadDialogSession}"
             HorizontalAlignment="Center" VerticalAlignment="Center">
  <Border Background="{DynamicResource Nester.DialogChrome.Background}"
          TextElement.Foreground="{DynamicResource Nester.DialogChrome.Foreground}"
          BorderBrush="{DynamicResource Nester.Border}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Nester.DialogChrome.CornerRadius}"
          Padding="{DynamicResource Nester.DialogChrome.Padding}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="{DynamicResource Nester.BlurRadius}"
                        ShadowDepth="2"
                        Opacity="0.2" />
    </Border.Effect>

  <Grid MinWidth="{DynamicResource Nester.Dialog.Width.Medium}" MaxWidth="{DynamicResource Nester.Dialog.MaxWidth.Medium}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Style="{DynamicResource Nester.DialogTitle.Style}" Text="{Binding Title}"
                   Visibility="{Binding Title, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,40,8" /> 
        <TextBlock Style="{DynamicResource Nester.DialogMessage.Style}" Text="{Binding Message}" Margin="0"
                   Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}" />
      </StackPanel>

      <Button Grid.Row="0" Style="{DynamicResource Nester.DialogClose.Style}" Content="✕"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              ToolTip="{Binding CloseText}"
              AutomationProperties.Name="{Binding CloseText}"
              Command="{Binding CloseCommand}" />
      <Border Grid.Row="1"
              BorderBrush="{DynamicResource Nester.Border}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Nester.CornerRadius.Medium}"
              Padding="14,10"
              Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="{Binding DisplayValue}"
                     FontSize="32"
                     FontWeight="SemiBold"
                     TextAlignment="Right"
                     HorizontalAlignment="Stretch" />
          <TextBlock Text="{Binding ResultHint}"
                     FontSize="{DynamicResource Nester.FontSize.Body}"
                     TextAlignment="Right"
                     Opacity="0.75"
                     HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>
      <Grid Grid.Row="2" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding RangeHint}"
                   VerticalAlignment="Center"
                   Opacity="0.75" />
      </Grid>
      <Grid Grid.Row="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Row="0" Grid.Column="0" Style="{DynamicResource Nester.KeypadButton.Style}" Content="C" Command="{Binding ClearCommand}" ToolTip="{Binding ClearToolTip}" />
        <Button Grid.Row="0" Grid.Column="1" Style="{DynamicResource Nester.KeypadButton.Style}" Content="÷" Command="{Binding AppendKeyCommand}" CommandParameter="/" />
        <Button Grid.Row="0" Grid.Column="2" Style="{DynamicResource Nester.KeypadButton.Style}" Content="×" Command="{Binding AppendKeyCommand}" CommandParameter="*" />
        <Button Grid.Row="0" Grid.Column="3" Style="{DynamicResource Nester.KeypadButton.Style}" Content="⌫" Command="{Binding BackspaceCommand}" ToolTip="{Binding BackspaceToolTip}" />

        <Button Grid.Row="1" Grid.Column="0" Style="{DynamicResource Nester.KeypadButton.Style}" Content="7" Command="{Binding AppendKeyCommand}" CommandParameter="7" />
        <Button Grid.Row="1" Grid.Column="1" Style="{DynamicResource Nester.KeypadButton.Style}" Content="8" Command="{Binding AppendKeyCommand}" CommandParameter="8" />
        <Button Grid.Row="1" Grid.Column="2" Style="{DynamicResource Nester.KeypadButton.Style}" Content="9" Command="{Binding AppendKeyCommand}" CommandParameter="9" />
        <Button Grid.Row="1" Grid.Column="3" Style="{DynamicResource Nester.KeypadButton.Style}" Content="-" Command="{Binding AppendKeyCommand}" CommandParameter="-" />

        <Button Grid.Row="2" Grid.Column="0" Style="{DynamicResource Nester.KeypadButton.Style}" Content="4" Command="{Binding AppendKeyCommand}" CommandParameter="4" />
        <Button Grid.Row="2" Grid.Column="1" Style="{DynamicResource Nester.KeypadButton.Style}" Content="5" Command="{Binding AppendKeyCommand}" CommandParameter="5" />
        <Button Grid.Row="2" Grid.Column="2" Style="{DynamicResource Nester.KeypadButton.Style}" Content="6" Command="{Binding AppendKeyCommand}" CommandParameter="6" />
        <Button Grid.Row="2" Grid.Column="3" Style="{DynamicResource Nester.KeypadButton.Style}" Content="+" Command="{Binding AppendKeyCommand}" CommandParameter="+" />

        <Button Grid.Row="3" Grid.Column="0" Style="{DynamicResource Nester.KeypadButton.Style}" Content="1" Command="{Binding AppendKeyCommand}" CommandParameter="1" />
        <Button Grid.Row="3" Grid.Column="1" Style="{DynamicResource Nester.KeypadButton.Style}" Content="2" Command="{Binding AppendKeyCommand}" CommandParameter="2" />
        <Button Grid.Row="3" Grid.Column="2" Style="{DynamicResource Nester.KeypadButton.Style}" Content="3" Command="{Binding AppendKeyCommand}" CommandParameter="3" />

        <Button Style="{DynamicResource Nester.KeypadPrimaryButton.Style}" Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Content="{Binding SmartButtonText}" Command="{Binding SmartConfirmCommand}" Height="Auto" VerticalAlignment="Stretch" />

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource Nester.KeypadButton.Style}" Content="0" Command="{Binding AppendKeyCommand}" CommandParameter="0" />
        <Button Grid.Row="4" Grid.Column="2" Style="{DynamicResource Nester.KeypadButton.Style}" Content="." Command="{Binding AppendKeyCommand}" CommandParameter="." />
      </Grid>
    </Grid>
  </Border>
</UserControl>
