<UserControl x:Class="Everlong.Nester.Controls.ImagePreviewDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:Everlong.Nester.Dialog;assembly=Everlong.Nester.Extensions"
             Background="Transparent" mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="960"
             d:DataContext="{d:DesignInstance c:ImagePreviewDialogSession}"
             HorizontalAlignment="Center" VerticalAlignment="Center">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <Border x:Name="ChromeBorder"
          Background="{DynamicResource Nester.ImagePreview.Backdrop}"
          TextElement.Foreground="{DynamicResource Nester.ImagePreview.Bar.Foreground}"
          CornerRadius="{DynamicResource Nester.DialogChrome.CornerRadius}"
          MinWidth="{DynamicResource Nester.ImagePreview.MinWidth}"
          MinHeight="{DynamicResource Nester.ImagePreview.MinHeight}"
          MaxWidth="{DynamicResource Nester.ImagePreview.MaxWidth}"
          MaxHeight="{DynamicResource Nester.ImagePreview.MaxHeight}"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="{DynamicResource Nester.BlurRadius}" ShadowDepth="2" Opacity="0.5" />
    </Border.Effect>
    <Grid ClipToBounds="True">
      <!-- Image Area -->
      <Image x:Name="PreviewImage"
             Source="{Binding CurrentImage}"
             Stretch="Uniform" ClipToBounds="True"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />

      <!-- Status Overlay (Loading/Error) -->
      <Border Background="{DynamicResource Nester.ImagePreview.Status.Background}"
              Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              CornerRadius="{DynamicResource Nester.DialogChrome.CornerRadius}">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="20,0,20,12"
                     Foreground="{DynamicResource Nester.ImagePreview.Status.Foreground}"
                     FontSize="{DynamicResource Nester.FontSize.Header}" />

          <ProgressBar Height="6"
                       Margin="50,0"
                       Foreground="{DynamicResource Nester.Brand}"
                       HorizontalAlignment="Stretch"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                       IsIndeterminate="True" />
        </StackPanel>
      </Border>

      <!-- Top Bar: Back Button, Title & Pager -->
      <Grid VerticalAlignment="Top" Height="50"
            Background="{DynamicResource Nester.ImagePreview.Bar.Background}">
        <Button HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Padding="8" Margin="8"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding CloseDialogCommand}">
          <Path Data="{DynamicResource Nester.Icon.Back}"
                Fill="{DynamicResource Nester.ImagePreview.Bar.Foreground}"
                Stretch="Uniform"
                Width="16"
                Height="16" />
        </Button>
        <TextBlock Text="{Binding Title}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="44,0,12,0"
                   FontWeight="Bold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Nester.ImagePreview.Bar.Foreground}"
                   FontSize="{DynamicResource Nester.FontSize.Header}"
                   IsHitTestVisible="False" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Visibility="{Binding IsMultiMode, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="{Binding IndexText}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Nester.ImagePreview.Bar.Foreground}"
                     Margin="0,0,8,0" />
          <Button Content="{Binding PreviousText}"
                  Margin="0,0,8,0"
                  Padding="10,4"
                  Command="{Binding GoPreviousCommand}"
                  IsEnabled="{Binding CanGoPrevious}" />
          <Button Content="{Binding NextText}"
                  Padding="10,4"
                  Command="{Binding GoNextCommand}"
                  IsEnabled="{Binding CanGoNext}" />
        </StackPanel>
      </Grid>

      <!-- Bottom Bar: Message & URL -->
      <Border VerticalAlignment="Bottom"
              Background="{DynamicResource Nester.ImagePreview.Caption.Background}"
              Padding="16,12"
              CornerRadius="{DynamicResource Nester.ImagePreview.Caption.CornerRadius}">
        <TextBlock Text="{Binding SourceText}"
                   Foreground="{DynamicResource Nester.ImagePreview.Caption.Foreground}"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </Grid>
  </Border>
</UserControl>
