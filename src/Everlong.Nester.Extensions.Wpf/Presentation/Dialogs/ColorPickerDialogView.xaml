<UserControl x:Class="Everlong.Nester.Presentation.ColorPickerDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:Everlong.Nester.Dialog;assembly=Everlong.Nester.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="380"
             d:DesignWidth="520"
             d:DataContext="{d:DesignInstance c:ColorPickerDialogSession}"
             HorizontalAlignment="Center" VerticalAlignment="Center">
  <Border Background="{DynamicResource Nester.DialogChrome.Background}"
          TextElement.Foreground="{DynamicResource Nester.DialogChrome.Foreground}"
          BorderBrush="{DynamicResource Nester.Border}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Nester.DialogChrome.CornerRadius}"
          Padding="{DynamicResource Nester.DialogChrome.Padding}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="{DynamicResource Nester.BlurRadius}"
                        ShadowDepth="2"
                        Opacity="0.2" />
    </Border.Effect>

  <Grid MinWidth="{DynamicResource Nester.Dialog.Width.Large}" MaxWidth="{DynamicResource Nester.Dialog.MaxWidth.Large}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Style="{DynamicResource Nester.DialogTitle.Style}" Text="{Binding Title}"
                   Visibility="{Binding Title, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,40,8" /> 
        <TextBlock Style="{DynamicResource Nester.DialogMessage.Style}" Text="{Binding Message}" Margin="0,0,0,12"
                   Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}" />
        <Border Height="60"
                CornerRadius="{DynamicResource Nester.CornerRadius.Medium}"
                Background="{Binding PreviewHex}"
                BorderBrush="{DynamicResource Nester.Border}"
                BorderThickness="1">
        <Border Background="{DynamicResource Nester.ColorChip.Background}" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,4">
          <TextBlock Text="{Binding PreviewHex}"
                     FontFamily="{DynamicResource Nester.FontFamily.Mono}"
                     FontSize="18"
                     FontWeight="Bold"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
      </Border>
      </StackPanel>

      <Button Grid.Row="0" Style="{DynamicResource Nester.DialogClose.Style}" Content="✕"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              ToolTip="{Binding CloseText}"
              AutomationProperties.Name="{Binding CloseText}"
              Command="{Binding CloseCommand}" />

      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="A" />
        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Alpha, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Alpha, StringFormat={}{0:F0}}" />
      </Grid>

      <Grid Grid.Row="2" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="R" />
        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Red, StringFormat={}{0:F0}}" />
      </Grid>

      <Grid Grid.Row="3" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="G" />
        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Green, StringFormat={}{0:F0}}" />
      </Grid>

      <Grid Grid.Row="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="B" />
          <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue, Mode=TwoWay}" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Blue, StringFormat={}{0:F0}}" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Style="{DynamicResource Nester.DialogAction.Style}" Content="{Binding ResetText}" Margin="0,0,10,0"
                  Command="{Binding ResetCommand}" />
          <Button Style="{DynamicResource Nester.PrimaryButton.Style}" Content="{Binding ConfirmText}"
                  Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
