<UserControl x:Class="Everlong.Nester.Presentation.ChoiceDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:Everlong.Nester.Dialog;assembly=Everlong.Nester.Extensions"
             mc:Ignorable="d" d:DesignHeight="200" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance c:ChoiceDialogSession}"
             HorizontalAlignment="Center" VerticalAlignment="Center">
  <Border Background="{DynamicResource Nester.DialogChrome.Background}"
          TextElement.Foreground="{DynamicResource Nester.DialogChrome.Foreground}"
          BorderBrush="{DynamicResource Nester.Border}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Nester.DialogChrome.CornerRadius}"
          Padding="{DynamicResource Nester.DialogChrome.Padding}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="{DynamicResource Nester.BlurRadius}"
                        ShadowDepth="2"
                        Opacity="0.2" />
    </Border.Effect>

    <StackPanel MinWidth="{DynamicResource Nester.Dialog.Width.Small}" MaxWidth="{DynamicResource Nester.Dialog.MaxWidth.Small}">
      <TextBlock Style="{DynamicResource Nester.DialogTitle.Style}" Text="{Binding Title}"
                 Visibility="{Binding Title, Converter={StaticResource StringToVisibilityConverter}}" />
      <TextBlock Style="{DynamicResource Nester.DialogMessage.Style}" Text="{Binding Message}"
                 Margin="0,0,0,20"
                 Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{DynamicResource Nester.DialogAction.Style}" Content="{Binding CancelText}" Margin="0,0,10,0"
                IsEnabled="{Binding IsCancelEnabled}"
                Command="{Binding CancelCommand}" />
        <Button Style="{DynamicResource Nester.DialogAction.Style}" Content="{Binding SecondaryText}" Margin="0,0,10,0"
                IsEnabled="{Binding IsSecondaryEnabled}"
                Command="{Binding SecondaryCommand}" />
        <Button Style="{DynamicResource Nester.PrimaryButton.Style}" Content="{Binding PrimaryText}"
                IsEnabled="{Binding IsPrimaryEnabled}"
                Command="{Binding PrimaryCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
