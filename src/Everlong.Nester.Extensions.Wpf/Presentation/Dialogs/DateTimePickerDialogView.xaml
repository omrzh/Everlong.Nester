<UserControl x:Class="Everlong.Nester.Presentation.DateTimePickerDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:Everlong.Nester.Dialog;assembly=Everlong.Nester.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="520"
             d:DataContext="{d:DesignInstance c:DateTimePickerDialogSession}"
             HorizontalAlignment="Center" VerticalAlignment="Center">
  <Border Background="{DynamicResource Nester.DialogChrome.Background}"
          TextElement.Foreground="{DynamicResource Nester.DialogChrome.Foreground}"
          BorderBrush="{DynamicResource Nester.Border}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Nester.DialogChrome.CornerRadius}"
          Padding="{DynamicResource Nester.DialogChrome.Padding}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="{DynamicResource Nester.BlurRadius}"
                        ShadowDepth="2"
                        Opacity="0.2" />
    </Border.Effect>

  <Grid MinWidth="{DynamicResource Nester.Dialog.Width.Large}"
        MaxWidth="{DynamicResource Nester.Dialog.MaxWidth.Large}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Style="{DynamicResource Nester.DialogTitle.Style}" Text="{Binding Title}"
                   Visibility="{Binding Title, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,40,8" /> 
        <TextBlock Style="{DynamicResource Nester.DialogMessage.Style}" Text="{Binding Message}" Margin="0"
                   Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}" />
      </StackPanel>

      <Button Grid.Row="0" Style="{DynamicResource Nester.DialogClose.Style}" Content="✕"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              ToolTip="{Binding CloseText}"
              AutomationProperties.Name="{Binding CloseText}"
              Command="{Binding CloseCommand}" />

      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
        <StackPanel Margin="4,0">
          <TextBlock Style="{DynamicResource Nester.DialogFieldLabel.Style}" Text="{Binding YearLabel}" />
          <TextBox Width="{DynamicResource Nester.Dialog.Field.Width}"
                   HorizontalContentAlignment="Center"
                   Text="{Binding YearText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Margin="4,0">
          <TextBlock Style="{DynamicResource Nester.DialogFieldLabel.Style}" Text="{Binding MonthLabel}" />
          <TextBox Width="{DynamicResource Nester.Dialog.Field.Width}"
                   HorizontalContentAlignment="Center"
                   Text="{Binding MonthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Margin="4,0">
          <TextBlock Style="{DynamicResource Nester.DialogFieldLabel.Style}" Text="{Binding DayLabel}" />
          <TextBox Width="{DynamicResource Nester.Dialog.Field.Width}"
                   HorizontalContentAlignment="Center"
                   Text="{Binding DayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Border Width="1" Margin="8,0" Opacity="0.6"
                Background="{DynamicResource Nester.Border}" />
        <StackPanel Margin="4,0">
          <TextBlock Style="{DynamicResource Nester.DialogFieldLabel.Style}" Text="{Binding HourLabel}" />
          <TextBox Width="{DynamicResource Nester.Dialog.Field.Width}"
                   HorizontalContentAlignment="Center"
                   Text="{Binding HourText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Margin="4,0">
          <TextBlock Style="{DynamicResource Nester.DialogFieldLabel.Style}" Text="{Binding MinuteLabel}" />
          <TextBox Width="{DynamicResource Nester.Dialog.Field.Width}"
                   HorizontalContentAlignment="Center"
                   Text="{Binding MinuteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Margin="4,0">
          <TextBlock Style="{DynamicResource Nester.DialogFieldLabel.Style}" Text="{Binding SecondLabel}" />
          <TextBox Width="{DynamicResource Nester.Dialog.Field.Width}"
                   HorizontalContentAlignment="Center"
                   Text="{Binding SecondText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Grid.Row="2" Style="{DynamicResource Nester.DialogPreview.Style}" Margin="0,16,0,4"
                 Text="{Binding PreviewText}" />
      <TextBlock Grid.Row="3" Margin="0,0,0,16" Opacity="0.7"
                 HorizontalAlignment="Center" Text="{Binding RangeHint}" />

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{DynamicResource Nester.DialogAction.Style}" Content="{Binding NowText}" Margin="0,0,10,0"
                Command="{Binding SetNowCommand}" />
        <Button Style="{DynamicResource Nester.PrimaryButton.Style}" Content="{Binding ConfirmText}"
                Command="{Binding ConfirmCommand}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
