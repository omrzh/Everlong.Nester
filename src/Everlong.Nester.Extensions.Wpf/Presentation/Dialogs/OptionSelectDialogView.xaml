<UserControl x:Class="Everlong.Nester.Presentation.OptionSelectDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:c="clr-namespace:Everlong.Nester.Dialog;assembly=Everlong.Nester.Extensions"
             xmlns:local="clr-namespace:Everlong.Nester.Presentation"
             mc:Ignorable="d" d:DesignHeight="260" d:DesignWidth="420"
             d:DataContext="{d:DesignInstance c:OptionSelectDialogSession}"
             HorizontalAlignment="Center" VerticalAlignment="Center">
  <Border Background="{DynamicResource Nester.DialogChrome.Background}"
          TextElement.Foreground="{DynamicResource Nester.DialogChrome.Foreground}"
          BorderBrush="{DynamicResource Nester.Border}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Nester.DialogChrome.CornerRadius}"
          Padding="{DynamicResource Nester.DialogChrome.Padding}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="{DynamicResource Nester.BlurRadius}"
                        ShadowDepth="2"
                        Opacity="0.2" />
    </Border.Effect>

  <Grid MinWidth="{DynamicResource Nester.Dialog.Width.Medium}" MaxWidth="{DynamicResource Nester.Dialog.MaxWidth.Medium}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Style="{DynamicResource Nester.DialogTitle.Style}" Text="{Binding Title}"
                   Visibility="{Binding Title, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,40,8" /> 
        <TextBlock Style="{DynamicResource Nester.DialogMessage.Style}" Text="{Binding Prompt}" Margin="0"
                   Visibility="{Binding Prompt, Converter={StaticResource StringToVisibilityConverter}}" />
      </StackPanel>

      <Button Grid.Row="0" Style="{DynamicResource Nester.DialogClose.Style}" Content="✕"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              ToolTip="{Binding CloseText}"
              AutomationProperties.Name="{Binding CloseText}"
              Command="{Binding CloseCommand}" />

      <ScrollViewer Grid.Row="1"
                    MaxHeight="{DynamicResource Nester.Dialog.Options.MaxHeight}"
                    VerticalAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{DynamicResource Nester.DialogOptionItem.Style}"
                      Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type local:OptionSelectDialogView}}}"
                      CommandParameter="{Binding}">
                 <ContentControl Content="{Binding Value}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>
  </Border>
</UserControl>
