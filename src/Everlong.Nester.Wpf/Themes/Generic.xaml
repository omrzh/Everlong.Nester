<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="TreeControl.xaml" />
    <ResourceDictionary Source="TreeItem.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

  <Style x:Key="Nester.NavTracker.Style" TargetType="ProgressBar"
         BasedOn="{StaticResource {x:Type ProgressBar}}">
    <Setter Property="Height" Value="{DynamicResource Nester.NavTracker.Height}" />
    <Setter Property="Foreground" Value="{DynamicResource Nester.NavTracker.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource Nester.NavTracker.Background}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

</ResourceDictionary>
