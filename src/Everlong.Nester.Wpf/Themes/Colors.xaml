<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Colors -->
  <Color x:Key="Nester.Color.Overlay">#80000000</Color>
  <Color x:Key="Nester.Color.Border">#E0E0E0</Color>

  <Color x:Key="Nester.Color.Success">#4CAF50</Color>
  <Color x:Key="Nester.Color.Error">#F44336</Color>
  <Color x:Key="Nester.Color.Warning">#FF9800</Color>
  <Color x:Key="Nester.Color.Info">#2196F3</Color>

  <!-- Brand / Primary (Fluent 2) -->
  <Color x:Key="Nester.Color.Brand">#0078D4</Color>
  <Color x:Key="Nester.Color.Brand.Hover">#106EBE</Color>
  <Color x:Key="Nester.Color.Brand.Pressed">#005A9E</Color>
  <Color x:Key="Nester.Color.Brand.Selected">#106EBE</Color>

  <!-- TreeItem Colors -->
  <Color x:Key="Nester.Color.TreeItem.Hover">#F0F0F0</Color>

  <SolidColorBrush x:Key="Nester.Overlay.Background" Color="{DynamicResource Nester.Color.Overlay}" />
  <SolidColorBrush x:Key="Nester.Border" Color="{DynamicResource Nester.Color.Border}" />

  <SolidColorBrush x:Key="Nester.Brand" Color="{DynamicResource Nester.Color.Brand}" />
  <SolidColorBrush x:Key="Nester.Brand.Hover" Color="{DynamicResource Nester.Color.Brand.Hover}" />
  <SolidColorBrush x:Key="Nester.Brand.Pressed" Color="{DynamicResource Nester.Color.Brand.Pressed}" />
  <SolidColorBrush x:Key="Nester.Brand.Selected" Color="{DynamicResource Nester.Color.Brand.Selected}" />

  <SolidColorBrush x:Key="Nester.Success" Color="{DynamicResource Nester.Color.Success}" />
  <SolidColorBrush x:Key="Nester.Error" Color="{DynamicResource Nester.Color.Error}" />
  <SolidColorBrush x:Key="Nester.Warning" Color="{DynamicResource Nester.Color.Warning}" />
  <SolidColorBrush x:Key="Nester.Info" Color="{DynamicResource Nester.Color.Info}" />
  <SolidColorBrush x:Key="Nester.Information" Color="{DynamicResource Nester.Color.Info}" />

  <SolidColorBrush x:Key="Nester.TreeItem.Hover" Color="{DynamicResource Nester.Color.TreeItem.Hover}" />
  <SolidColorBrush x:Key="Nester.NavTracker.Foreground" Color="{DynamicResource Nester.Color.Brand}" />
  <SolidColorBrush x:Key="Nester.NavTracker.Background" Color="{DynamicResource Nester.Color.Border}" />

  <Thickness x:Key="Nester.TreeItem.IndentMargin">16,0,0,0</Thickness>

  <!-- TreeItem Chevron Icons (override to customize the expand/collapse indicator) -->
  <StreamGeometry x:Key="Nester.Icon.TreeItem.Chevron.Collapsed">M10 6 L8.59 7.41 13.17 12 8.59 16.59 10 18 16 12 Z</StreamGeometry>
  <StreamGeometry x:Key="Nester.Icon.TreeItem.Chevron.Expanded">M16.59 8.59 L12 13.17 7.41 8.59 6 10 12 16 18 10 Z</StreamGeometry>

  <!-- Icons -->
  <StreamGeometry x:Key="Nester.Icon.Success">M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z</StreamGeometry>
  <StreamGeometry x:Key="Nester.Icon.Error">M12 2C6.48 2 2 6.48 2 12S6.48 22 12 22 22 17.52 22 12 17.52 2 12 2M13 17H11V15H13V17M13 13H11V7H13V13Z</StreamGeometry>
  <StreamGeometry x:Key="Nester.Icon.Warning">M1 21H23L12 2L1 21M13 18H11V16H13V18M13 14H11V10H13V14Z</StreamGeometry>
  <StreamGeometry x:Key="Nester.Icon.Info">M12 2C6.48 2 2 6.48 2 12S6.48 22 12 22 22 17.52 22 12 17.52 2 12 2M13 17H11V11H13V17M13 9H11V7H13V9Z</StreamGeometry>
  <StreamGeometry x:Key="Nester.Icon.Information">M12 2C6.48 2 2 6.48 2 12S6.48 22 12 22 22 17.52 22 12 17.52 2 12 2M13 17H11V11H13V17M13 9H11V7H13V9Z</StreamGeometry>
  <StreamGeometry x:Key="Nester.Icon.Dismiss">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
  <!-- Dimensions & Shapes -->
  <CornerRadius x:Key="Nester.CornerRadius.Small">4</CornerRadius>
  <CornerRadius x:Key="Nester.CornerRadius.Medium">8</CornerRadius>
  <Thickness x:Key="Nester.Padding.Small">10</Thickness>
  <Thickness x:Key="Nester.Padding.Medium">15</Thickness>
  <Thickness x:Key="Nester.Padding.Large">20</Thickness>
  <Thickness x:Key="Nester.Margin.Small">5</Thickness>

  <sys:Double x:Key="Nester.Icon.Size.Small">20</sys:Double>
  <sys:Double x:Key="Nester.BlurRadius">10</sys:Double>
  <sys:Double x:Key="Nester.NavTracker.Height">4</sys:Double>
</ResourceDictionary>
