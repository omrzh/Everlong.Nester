<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The dark half of the core palette.  WPF has no ThemeDictionaries, so the
    app merges this dictionary on top of Colors.xaml (see NesterTheme.UseDark).
    The brushes are redefined here on purpose: replacing only the color keys
    leaves the light brush instances in place — a brush's own DynamicResource
    Color does not re-resolve after the dictionary is sealed, while a replaced
    brush key is picked up by every DynamicResource consumer.
  -->
  <Color x:Key="Nester.Color.Overlay">#80000000</Color>
  <Color x:Key="Nester.Color.Border">#404040</Color>

  <Color x:Key="Nester.Color.Success">#66BB6A</Color>
  <Color x:Key="Nester.Color.Error">#EF5350</Color>
  <Color x:Key="Nester.Color.Warning">#FFA726</Color>
  <Color x:Key="Nester.Color.Info">#42A5F5</Color>

  <!-- Brand / Primary (Fluent 2) -->
  <Color x:Key="Nester.Color.Brand">#3A96DD</Color>
  <Color x:Key="Nester.Color.Brand.Hover">#2886CD</Color>
  <Color x:Key="Nester.Color.Brand.Pressed">#1A76BD</Color>
  <Color x:Key="Nester.Color.Brand.Selected">#2886CD</Color>

  <!-- TreeItem Colors -->
  <Color x:Key="Nester.Color.TreeItem.Hover">#333333</Color>

  <SolidColorBrush x:Key="Nester.Overlay.Background" Color="{StaticResource Nester.Color.Overlay}" />
  <SolidColorBrush x:Key="Nester.Border" Color="{StaticResource Nester.Color.Border}" />

  <SolidColorBrush x:Key="Nester.Brand" Color="{StaticResource Nester.Color.Brand}" />
  <SolidColorBrush x:Key="Nester.Brand.Hover" Color="{StaticResource Nester.Color.Brand.Hover}" />
  <SolidColorBrush x:Key="Nester.Brand.Pressed" Color="{StaticResource Nester.Color.Brand.Pressed}" />
  <SolidColorBrush x:Key="Nester.Brand.Selected" Color="{StaticResource Nester.Color.Brand.Selected}" />

  <SolidColorBrush x:Key="Nester.Success" Color="{StaticResource Nester.Color.Success}" />
  <SolidColorBrush x:Key="Nester.Error" Color="{StaticResource Nester.Color.Error}" />
  <SolidColorBrush x:Key="Nester.Warning" Color="{StaticResource Nester.Color.Warning}" />
  <SolidColorBrush x:Key="Nester.Info" Color="{StaticResource Nester.Color.Info}" />
  <SolidColorBrush x:Key="Nester.Information" Color="{StaticResource Nester.Color.Info}" />

  <SolidColorBrush x:Key="Nester.TreeItem.Hover" Color="{StaticResource Nester.Color.TreeItem.Hover}" />
  <SolidColorBrush x:Key="Nester.NavTracker.Foreground" Color="{StaticResource Nester.Color.Brand}" />
  <SolidColorBrush x:Key="Nester.NavTracker.Background" Color="{StaticResource Nester.Color.Border}" />
</ResourceDictionary>
