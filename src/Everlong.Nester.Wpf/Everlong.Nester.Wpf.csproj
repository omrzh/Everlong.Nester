<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\NesterVersion.props" />

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Everlong.Nester</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Everlong.Nester.Extensions.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Everlong.Nester\Everlong.Nester.csproj" />
  </ItemGroup>

  <!-- Single-source file shared with the Avalonia platform project (kept in Avalonia) -->
  <ItemGroup>
    <!-- DI -->
    <Compile Include="..\Everlong.Nester.Avalonia\DI\ServiceCollectionExtensions.cs" Link="DI\ServiceCollectionExtensions.cs" />
    <!-- Controls -->
    <Compile Include="..\Everlong.Nester.Avalonia\Controls\StagePanel.cs" Link="Controls\StagePanel.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Controls\NavigationHost.cs" Link="Controls\NavigationHost.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Controls\ContentLayerLease.cs" Link="Controls\ContentLayerLease.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Controls\TreeControl.shared.cs" Link="Controls\TreeControl.shared.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Controls\TreeItem.shared.cs" Link="Controls\TreeItem.shared.cs" />
    <!-- Routing -->
    <Compile Include="..\Everlong.Nester.Avalonia\Routing\Router.cs" Link="Routing\Router.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Routing\PlatformStackModel.cs" Link="Routing\PlatformStackModel.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Routing\PlatformStages.cs" Link="Routing\PlatformStages.cs" />
    <!-- Presentation -->
    <Compile Include="..\Everlong.Nester.Avalonia\Presentation\SharedAttributes.cs" Link="Presentation\SharedAttributes.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Presentation\ShellFlyingLayer.cs" Link="Presentation\ShellFlyingLayer.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Presentation\ISceneTransition.cs" Link="Presentation\ISceneTransition.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Presentation\TransitionKind.cs" Link="Presentation\TransitionKind.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Presentation\TransitionContext.cs" Link="Presentation\TransitionContext.cs" />
    <Compile Include="..\Everlong.Nester.Avalonia\Presentation\ILayoutControl.cs" Link="Presentation\ILayoutControl.cs" />
  </ItemGroup>

</Project>
