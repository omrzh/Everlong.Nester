<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\NesterVersion.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    <Compile Include="..\Everlong.Nester.Generators\Constants\Attributes.cs" Link="Constants\Attributes.cs" />
    <Compile Include="..\Everlong.Nester.Generators\Constants\Conventions.cs" Link="Constants\Conventions.cs" />
    <Compile Include="..\Everlong.Nester.Generators\Constants\Ns.cs" Link="Constants\Ns.cs" />
    <Compile Include="..\Everlong.Nester.Generators\Descriptors.cs" Link="Descriptors.cs" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\Everlong.Nester.Generators\AnalyzerReleases.Shipped.md" Link="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="..\Everlong.Nester.Generators\AnalyzerReleases.Unshipped.md" Link="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
