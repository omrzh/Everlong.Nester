<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\NesterVersion.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Everlong.Nester</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <AvaloniaXamlIlVerifyIl>false</AvaloniaXamlIlVerifyIl>
    <AvaloniaXamlReportImportance>high</AvaloniaXamlReportImportance>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaDesignerSupported>false</AvaloniaDesignerSupported>

    <PackageId>Everlong.Nester.Extensions.Avalonia</PackageId>
    <Authors>Richard Zheng</Authors>
    <Company>Everlong Technology</Company>
    <Copyright>Copyright © 2026 Everlong Technology</Copyright>
    <Description>Nester extensions for Avalonia — the default views of the built-in dialog sessions and notice entries, the notice tenant and engine, the route-sync chrome controls, the authorization gating controls and the scene-transition kit.</Description>
    <PackageTags>Avalonia;Navigation;Dialogs;Auth</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/omrzh/Everlong.Nester</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Everlong.Nester.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Everlong.Nester\Everlong.Nester.csproj" />
    <ProjectReference Include="..\Everlong.Nester.Avalonia\Everlong.Nester.Avalonia.csproj" />
    <ProjectReference Include="..\Everlong.Nester.Extensions\Everlong.Nester.Extensions.csproj" />
  </ItemGroup>

</Project>
