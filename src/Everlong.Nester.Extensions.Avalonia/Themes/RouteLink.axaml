<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="using:Everlong.Nester.Controls">

  <ControlTheme x:Key="{x:Type v:RouteLink}" TargetType="v:RouteLink">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="LinkBorder"
                Background="Transparent"
                CornerRadius="4">
          <Button Name="PART_LinkButton"
                  Background="Transparent"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  Cursor="Hand">
            <Button.Template>
              <ControlTemplate>
                <!-- Transparent background keeps the whole area hit-testable -->
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
              </ControlTemplate>
            </Button.Template>
            <Grid>
              <StackPanel Name="DefaultContent"
                          Orientation="Horizontal"
                          Spacing="10"
                          IsVisible="False">
                <ContentPresenter Name="IconHost"
                                  Content="{TemplateBinding Icon}"
                                  VerticalAlignment="Center" />
                <TextBlock Name="TitleText"
                           Text="{TemplateBinding Title}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <ContentPresenter Name="CustomContent"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsVisible="False" />
            </Grid>
          </Button>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[UseDefaultContent=true] /template/ StackPanel#DefaultContent">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[UseDefaultContent=false] /template/ ContentPresenter#CustomContent">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[HasIcon=false] /template/ ContentPresenter#IconHost">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^ /template/ Border#LinkBorder:pointerover">
      <Setter Property="Background" Value="{DynamicResource Nester.RouteLink.Hover}" />
    </Style>

    <Style Selector="^[IsActive=true] /template/ Border#LinkBorder">
      <Setter Property="Background" Value="{DynamicResource Nester.RouteLink.Active.Background}" />
    </Style>
    <Style Selector="^[IsActive=true] /template/ TextBlock#TitleText">
      <Setter Property="Foreground" Value="{DynamicResource Nester.RouteLink.Active.Foreground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
