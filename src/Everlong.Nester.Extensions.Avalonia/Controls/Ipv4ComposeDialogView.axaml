<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:Everlong.Nester.Dialog"
             xmlns:cv="using:Everlong.Nester.Converters"
             mc:Ignorable="d" d:DesignWidth="430" d:DesignHeight="660"
             x:Class="Everlong.Nester.Controls.Ipv4ComposeDialogView"
             x:DataType="c:Ipv4ComposerDialogSession"
             HorizontalAlignment="Center" VerticalAlignment="Center">
  <Design.DataContext>
    <c:Ipv4ComposerDialogSession />
  </Design.DataContext>
    <UserControl.Resources>
    <cv:IndexToBoolConverter x:Key="IndexToBoolConverter" />
  </UserControl.Resources>
<Border Background="{DynamicResource Nester.DialogChrome.Background}"
          TextElement.Foreground="{DynamicResource Nester.DialogChrome.Foreground}"
          BorderBrush="{DynamicResource Nester.Border}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Nester.DialogChrome.CornerRadius}"
          Padding="{DynamicResource Nester.DialogChrome.Padding}"
          BoxShadow="{DynamicResource Nester.DialogChrome.Shadow}">

  <Grid MinWidth="{DynamicResource Nester.Dialog.Width.Medium}" MaxWidth="{DynamicResource Nester.Dialog.MaxWidth.Medium}" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Spacing="12">

        <StackPanel>
          <TextBlock Classes="DialogTitle" Text="{Binding Title}"
                     IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,0,40,8" /> 
          <TextBlock Classes="DialogMessage" Text="{Binding Message}" Margin="0"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
          <Button Command="{Binding SetActivePartCommand}" CommandParameter="0"
                  Background="Transparent" Padding="0" BorderThickness="0">
            <Border Classes="IpPart"
                    Classes.Active="{Binding ActivePartIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=0}">
              <TextBlock Classes="IpText" Text="{Binding Part1}" />
            </Border>
          </Button>
          <TextBlock Text="." FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Opacity="0.5" />

          <Button Command="{Binding SetActivePartCommand}" CommandParameter="1"
                  Background="Transparent" Padding="0" BorderThickness="0">
            <Border Classes="IpPart"
                    Classes.Active="{Binding ActivePartIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=1}">
              <TextBlock Classes="IpText" Text="{Binding Part2}" />
            </Border>
          </Button>
          <TextBlock Text="." FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Opacity="0.5" />

          <Button Command="{Binding SetActivePartCommand}" CommandParameter="2"
                  Background="Transparent" Padding="0" BorderThickness="0">
            <Border Classes="IpPart"
                    Classes.Active="{Binding ActivePartIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=2}">
              <TextBlock Classes="IpText" Text="{Binding Part3}" />
            </Border>
          </Button>
          <TextBlock Text="." FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Opacity="0.5" />

          <Button Command="{Binding SetActivePartCommand}" CommandParameter="3"
                  Background="Transparent" Padding="0" BorderThickness="0">
            <Border Classes="IpPart"
                    Classes.Active="{Binding ActivePartIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=3}">
              <TextBlock Classes="IpText" Text="{Binding Part4}" />
            </Border>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        </StackPanel>

        <Grid RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*">
          <Button Grid.Row="0" Grid.Column="0" Classes="Keypad" Command="{Binding PingCommand}"
                  Content="{Binding PingText}"
                  IsEnabled="{Binding CanPing}" />
          <Button Grid.Row="0" Grid.Column="1" Classes="Keypad" Command="{Binding ClearCommand}"
                  Content="{Binding ClearText}" />
          <Button Grid.Row="0" Grid.Column="2" Classes="Keypad" Command="{Binding BackspaceCommand}" Content="⌫"
                  ToolTip.Tip="{Binding BackspaceToolTip}" />
          <Button Grid.Row="1" Grid.Column="0" Classes="Keypad" Content="1" Command="{Binding AppendKeyCommand}"
                  CommandParameter="1" />
          <Button Grid.Row="1" Grid.Column="1" Classes="Keypad" Content="2" Command="{Binding AppendKeyCommand}"
                  CommandParameter="2" />
          <Button Grid.Row="1" Grid.Column="2" Classes="Keypad" Content="3" Command="{Binding AppendKeyCommand}"
                  CommandParameter="3" />

          <Button Grid.Row="2" Grid.Column="0" Classes="Keypad" Content="4" Command="{Binding AppendKeyCommand}"
                  CommandParameter="4" />
          <Button Grid.Row="2" Grid.Column="1" Classes="Keypad" Content="5" Command="{Binding AppendKeyCommand}"
                  CommandParameter="5" />
          <Button Grid.Row="2" Grid.Column="2" Classes="Keypad" Content="6" Command="{Binding AppendKeyCommand}"
                  CommandParameter="6" />

          <Button Grid.Row="3" Grid.Column="0" Classes="Keypad" Content="7" Command="{Binding AppendKeyCommand}"
                  CommandParameter="7" />
          <Button Grid.Row="3" Grid.Column="1" Classes="Keypad" Content="8" Command="{Binding AppendKeyCommand}"
                  CommandParameter="8" />
          <Button Grid.Row="3" Grid.Column="2" Classes="Keypad" Content="9" Command="{Binding AppendKeyCommand}"
                  CommandParameter="9" />

          <Button Grid.Row="4" Grid.Column="0" Classes="Keypad" Content="0" Command="{Binding AppendKeyCommand}"
                  CommandParameter="0" />
          <Button Classes="DialogAction Primary" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                  Content="{Binding ConfirmText}"
                  HorizontalAlignment="Stretch"
                  Margin="4,0,0,0"
                  Padding="0,12"
                  Command="{Binding ConfirmCommand}" />
        </Grid>
      </StackPanel>
      <Button Grid.Row="0" Classes="DialogClose" Content="✕"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              ToolTip.Tip="{Binding CloseText}"
              AutomationProperties.Name="{Binding CloseText}"
              Command="{Binding CloseCommand}" />
    </Grid>
  </Border>
</UserControl>
