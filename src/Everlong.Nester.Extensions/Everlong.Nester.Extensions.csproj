<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\NesterVersion.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Everlong.Nester</RootNamespace>
    <Elg>true</Elg>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <PackageId>Everlong.Nester.Extensions</PackageId>
    <Authors>Richard Zheng</Authors>
    <Company>Everlong Technology</Company>
    <Copyright>Copyright © 2026 Everlong Technology</Copyright>
    <Description>Nester extensions — the MvvmTk layer: the component-model bases, the built-in dialog sessions, the notice contracts, the route-sync contracts and the policy-based authorization engine.</Description>
    <PackageTags>Navigation;Dialog;Auth;Mvvm;Avalonia;WPF</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/omrzh/Everlong.Nester</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Everlong.Nester.Extensions.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Everlong.Globalization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Everlong.Nester\Everlong.Nester.csproj" />
  </ItemGroup>

</Project>
