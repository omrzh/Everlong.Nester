<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\NesterVersion.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Everlong.Nester.Tests" />
    <InternalsVisibleTo Include="Everlong.Nester.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Everlong.DI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Everlong.Nester.Abstractions\Everlong.Nester.Abstractions.csproj" />
  </ItemGroup>

</Project>
