<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\NesterVersion.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Everlong.Nester</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <AvaloniaXamlIlVerifyIl>false</AvaloniaXamlIlVerifyIl>
    <AvaloniaXamlReportImportance>high</AvaloniaXamlReportImportance>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaDesignerSupported>false</AvaloniaDesignerSupported>

    <PackageId>Everlong.Nester.Avalonia</PackageId>
    <Authors>Richard Zheng</Authors>
    <Company>Everlong Technology</Company>
    <Copyright>Copyright © 2026 Everlong Technology</Copyright>
    <Description>Nester for Avalonia — the platform surface: the routing stages, the layout and layer plumbing, the presentation protocol and the tree primitives.</Description>
    <PackageTags>Avalonia;Navigation;Dialogs</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/omrzh/Everlong.Nester</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Everlong.Nester.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Everlong.Nester\Everlong.Nester.csproj" />
  </ItemGroup>

  <!-- The package readme is the repository's own readme.md, packed at the root of
       the package — the same file both platform packages point at. -->
  <ItemGroup>
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" Link="readme.md" />
  </ItemGroup>

</Project>
