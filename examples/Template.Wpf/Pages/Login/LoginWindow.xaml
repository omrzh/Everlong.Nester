<Window x:Class="NesterApp.Pages.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NesterApp.Pages.Login"
        xmlns:props="clr-namespace:NesterApp.Properties"
        xmlns:n="https://nester.dev"
        mc:Ignorable="d" d:DesignHeight="360" d:DesignWidth="420"
        d:DataContext="{d:DesignInstance Type=viewModels:LoginWindowModel}"
        Height="360" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
  <!--
    Custom-chrome login window — the custom startup-animation demo surface:
    WindowStyle=None + AllowsTransparency=True strip the standard Win32 window
    styles, so DWM does NOT play its native open animation — the entrance
    animation is entirely ours (see the shell's OnStarted → PlayEntranceAnimationAsync).
    The rounded Border is the window's face (drag zone + close button).
  -->
  <Border x:Name="RootBorder" CornerRadius="8"
          Background="{DynamicResource Nester.DialogChrome.Background}"
          MouseLeftButtonDown="OnDragMove">
    <Grid>
      <ContentControl x:Name="RootSlot" />
      <Button x:Name="CloseButton"
              Width="36" Height="36"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,4,4,0"
              Command="{Binding CloseCommand}"
              Background="Transparent" BorderThickness="0"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              ToolTip="{Binding Source={x:Static props:Lang.Navigation}, Path=Close}" >
        <TextBlock Text="&#xE711;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>
    </Grid>
  </Border>
</Window>
