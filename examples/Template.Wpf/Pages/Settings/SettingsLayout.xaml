<UserControl x:Class="NesterApp.Pages.Settings.SettingsLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:n="https://nester.dev"
             xmlns:viewmodels="clr-namespace:NesterApp.Pages.Settings"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsLayoutModel}"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">


  <UserControl.Resources>
  </UserControl.Resources>

  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Settings Sidebar -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource App.Sidebar.Border}" BorderThickness="0,0,1,0"
            Padding="0,0,20,0">
      <StackPanel>
        <TextBlock Text="{Binding Header}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" />

        <ItemsControl ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <n:RouteLink
                Padding="10" Background="Transparent" BorderThickness="0">
                <TextBlock Text="{Binding Title}" />
              </n:RouteLink>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </Border>

    <!-- Content -->
    <n:BodyPanel x:Name="Body" Grid.Column="1" Margin="20,0,0,0" />
  </Grid>


</UserControl>
