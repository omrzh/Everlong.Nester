<UserControl x:Class="NesterApp.Pages.Auth.AuthLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:n="https://nester.dev"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid>

    <Border VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="400"
            Background="{DynamicResource App.Card.Background}" CornerRadius="8"
            Padding="0">
      <Border.Effect>
        <DropShadowEffect Color="Gray" BlurRadius="20" ShadowDepth="5" Opacity="0.2" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource Nester.Brand}" CornerRadius="8,8,0,0" Padding="20">
          <StackPanel HorizontalAlignment="Center">
            <!-- Fallback icon or simple text if icon not available -->
            <emoji:TextBlock Text="🧭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock Text="NesterApp" Foreground="White" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Content Mount Point -->
        <n:LayoutBody x:Name="Body" Grid.Row="1" Margin="20" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
