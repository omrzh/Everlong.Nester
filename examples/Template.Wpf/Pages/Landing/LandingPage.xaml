<UserControl x:Class="NesterApp.Pages.Landing.LandingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NesterApp.Pages.Landing"
             d:DataContext="{d:DesignInstance vm:LandingPageModel }"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
  <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{Binding PagesStrings.DashboardTitle}" FontSize="30" FontWeight="Bold" Margin="0,0,0,10" />
      <TextBlock Text="{Binding PagesStrings.DashboardSubtitle}"
                 Foreground="{DynamicResource App.Muted.Foreground}" Margin="0,0,0,20" />

      <WrapPanel Margin="0,0,0,24">
        <Border Margin="0,0,16,16" Width="220" Background="{DynamicResource App.Card.Background}" CornerRadius="8"
                Padding="16">
          <Border.Effect>
            <DropShadowEffect Color="LightGray" BlurRadius="5" ShadowDepth="2" Opacity="0.3" />
          </Border.Effect>
          <StackPanel>
            <TextBlock Text="{Binding PagesStrings.Feature1Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PagesStrings.Feature1Desc}" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Margin="0,0,16,16" Width="220" Background="{DynamicResource App.Card.Background}" CornerRadius="8"
                Padding="16">
          <Border.Effect>
            <DropShadowEffect Color="LightGray" BlurRadius="5" ShadowDepth="2" Opacity="0.3" />
          </Border.Effect>
          <StackPanel>
            <TextBlock Text="{Binding PagesStrings.Feature2Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PagesStrings.Feature2Desc}" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Margin="0,0,16,16" Width="220" Background="{DynamicResource App.Card.Background}" CornerRadius="8"
                Padding="16">
          <Border.Effect>
            <DropShadowEffect Color="LightGray" BlurRadius="5" ShadowDepth="2" Opacity="0.3" />
          </Border.Effect>
          <StackPanel>
            <TextBlock Text="{Binding PagesStrings.Feature3Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PagesStrings.Feature3Desc}" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <TextBlock Text="{Binding PagesStrings.EntryHeader}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
      <WrapPanel>
        <Button Content="{Binding PagesStrings.OpenInteractionLab}" Command="{Binding OpenInteractionLabCommand}"
                Margin="0,0,12,12" Padding="14,8" />
        <Button Content="{Binding PagesStrings.OpenPosts}" Command="{Binding OpenPostsCommand}" Margin="0,0,12,12"
                Padding="14,8" />
        <Button Content="{Binding PagesStrings.OpenProfile}" Command="{Binding OpenProfileCommand}" Margin="0,0,12,12"
                Padding="14,8" />
        <Button Content="{Binding PagesStrings.OpenSettings}" Command="{Binding OpenSettingsCommand}"
                Margin="0,0,12,12" Padding="14,8" />
        <Button Content="{Binding PagesStrings.OpenAdmin}" Command="{Binding OpenAdminCommand}" Margin="0,0,12,12"
                Padding="14,8" />
      </WrapPanel>

      <!-- The palette has no button by design (its gesture is the point) — so
           the landing page names it once, where a user actually lands. -->
      <TextBlock Text="{Binding WorkspaceStrings.LandingHint}" FontSize="20" FontWeight="Bold" Margin="0,12,0,8" />
      <TextBlock Text="{Binding WorkspaceStrings.LandingHintNote}"
                 Foreground="{DynamicResource App.Muted.Foreground}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
