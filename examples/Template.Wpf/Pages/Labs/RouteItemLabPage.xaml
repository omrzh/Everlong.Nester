<UserControl x:Class="NesterApp.Pages.Labs.RouteItemLabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:n="https://nester.dev"
             xmlns:vm="clr-namespace:NesterApp.Pages.Labs"
             xmlns:views="clr-namespace:NesterApp.Pages.Labs"
             xmlns:props="clr-namespace:NesterApp.Properties"
             d:DataContext="{d:DesignInstance vm:RouteItemLabPageModel}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

  <UserControl.Resources>
    <!--
      Pattern B: DataTemplate for SvgIcon - the ContentPresenter inside RouteLink resolves
      this template by type and renders the path geometry as a Path element.
      SvgIcon is a plain C# record; the view model has no UI dependency.
    -->
    <views:SvgIconConverter x:Key="SvgIconConverter" />
    <DataTemplate DataType="{x:Type vm:SvgIcon}">
      <Viewbox Width="16" Height="16">
        <Path Data="{Binding PathData, Converter={StaticResource SvgIconConverter}}"
              Fill="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
              Stretch="Uniform" />
      </Viewbox>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20">
    <StackPanel>
      <TextBlock Text="{Binding LabsStrings.RouteItemLabTitle}" FontSize="30" FontWeight="Bold" Margin="0,0,0,8" />
      <TextBlock Text="{Binding LabsStrings.RouteItemLabSubtitle}"
                 Foreground="{DynamicResource App.Muted.Foreground}" Margin="0,0,0,20" />

      <!-- Section A: Flat nav with ItemsControl + RouteLink (existing approach, reference) -->
      <TextBlock Text="{Binding LabsStrings.SectionATitle}"
                 FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBlock Text="{Binding LabsStrings.SectionADesc}" Foreground="{DynamicResource App.Muted.Foreground}"
                 Margin="0,0,0,8" />
      <Border Background="{DynamicResource App.Card.Background}" CornerRadius="8" Padding="8" BorderBrush="{DynamicResource App.Card.BorderBrush}"
              BorderThickness="1"
              Margin="0,0,0,24">
        <ItemsControl ItemsSource="{Binding FlatNavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <n:RouteLink />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Text="{Binding LabsStrings.SectionA2Title}"
                 FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBlock Text="{Binding LabsStrings.SectionA2Desc}" Foreground="{DynamicResource App.Muted.Foreground}"
                 Margin="0,0,0,8" />
      <Border Background="{DynamicResource App.Card.Background}" CornerRadius="8" Padding="8" BorderBrush="{DynamicResource App.Card.BorderBrush}"
              BorderThickness="1"
              Margin="0,0,0,24">
        <ItemsControl ItemsSource="{Binding FlatNavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <n:RouteLink>
                <StackPanel Orientation="Horizontal">
                  <!-- Resolve the EmojiIcon record through the implicit DataTemplate
                       (the same lookup RouteLink's own IconHost uses) — binding Icon to
                       a TextBlock would print the record's ToString() instead. -->
                  <ContentPresenter Content="{Binding Icon}" Width="20"
                                    HorizontalAlignment="Center" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding Title}" />
                </StackPanel>
              </n:RouteLink>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Section B: Tree nav using RouteTreeControl -->
      <TextBlock Text="{Binding LabsStrings.SectionBTitle}"
                 FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource App.Muted.Foreground}" Margin="0,0,0,8">
        <Run Text="{Binding LabsStrings.SectionBDesc1, Mode=OneWay}" /><LineBreak />
        <Run Text="{Binding LabsStrings.SectionBDesc2, Mode=OneWay}" />
        <Run Text="{Binding LabsStrings.SectionBDesc3, Mode=OneWay}" />
      </TextBlock>
      <Border Background="{DynamicResource App.Card.Background}" CornerRadius="8" Padding="8" BorderBrush="{DynamicResource App.Card.BorderBrush}"
              BorderThickness="1"
              Margin="0,0,0,24">
        <n:RouteTreeControl ItemsSource="{Binding TreeNavItems}" />
      </Border>

      <!-- Section C: Pure TreeControl (no navigation) -->
      <TextBlock Text="{Binding LabsStrings.SectionCTitle}"
                 FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource App.Muted.Foreground}" Margin="0,0,0,8">
        <Run Text="{Binding LabsStrings.SectionCDesc1, Mode=OneWay}" /><LineBreak />
        <Run Text="{Binding LabsStrings.SectionCDesc2, Mode=OneWay}" />
      </TextBlock>
      <Border Background="{DynamicResource App.Card.Background}" CornerRadius="8" Padding="8" BorderBrush="{DynamicResource App.Card.BorderBrush}"
              BorderThickness="1">
        <n:TreeControl ItemsSource="{Binding TreeControlNodes}">
          <n:TreeControl.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNode}" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Padding="0 4">
                <TextBlock.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{Binding Source={x:Static props:Lang.Labs}, Path=PlaceholderMenu1}" />
                    <MenuItem Header="{Binding Source={x:Static props:Lang.Labs}, Path=PlaceholderMenu2}" />
                    <MenuItem Header="{Binding Source={x:Static props:Lang.Labs}, Path=PlaceholderMenu3}" />
                  </ContextMenu>
                </TextBlock.ContextMenu>
              </TextBlock>
            </HierarchicalDataTemplate>
          </n:TreeControl.ItemTemplate>
        </n:TreeControl>
      </Border>

      <!-- Section D: Custom Icon - Pattern B (SvgIcon record + DataTemplate) -->
      <TextBlock Text="{Binding LabsStrings.SectionDTitle}"
                 FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource App.Muted.Foreground}" Margin="0,0,0,8">
        <Run Text="{Binding LabsStrings.SectionDDesc1, Mode=OneWay}" /><LineBreak />
        <Run Text="{Binding LabsStrings.SectionDDesc2, Mode=OneWay}" />
      </TextBlock>
      <Border Background="{DynamicResource App.Card.Background}" CornerRadius="8" Padding="8" BorderBrush="{DynamicResource App.Card.BorderBrush}"
              BorderThickness="1"
              Margin="0,0,0,24">
        <n:RouteTreeControl ItemsSource="{Binding SvgIconNavItems}" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
