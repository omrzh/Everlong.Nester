<UserControl x:Class="NesterApp.Pages.Labs.InteractionLabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NesterApp.Pages.Labs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InteractionLabPageModel}"
             d:DesignHeight="600" d:DesignWidth="1000">
  <Grid Margin="20">

    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="2*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding LabsStrings.InteractionLabTitle}" FontSize="28" FontWeight="Bold" Margin="0,0,0,12" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
      <StackPanel>
        <TextBlock Text="{Binding LabsStrings.InteractionLabSubtitle}"
                   Foreground="{DynamicResource App.Muted.Foreground}" Margin="0,0,0,20" />

        <TextBlock Text="{Binding LabsStrings.Notifications}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
        <WrapPanel Margin="0,0,0,16">
          <Button Content="{Binding LabsStrings.Info}" Command="{Binding ShowInfoNotificationCommand}"
                  Margin="0,0,10,0" Padding="10,6" />
          <Button Content="{Binding LabsStrings.Success}" Command="{Binding ShowSuccessNotificationCommand}"
                  Margin="0,0,10,0" Padding="10,6" />
          <Button Content="{Binding LabsStrings.Warning}" Command="{Binding ShowWarningNotificationCommand}"
                  Margin="0,0,10,0" Padding="10,6" />
          <Button Content="{Binding LabsStrings.Error}" Command="{Binding ShowErrorNotificationCommand}" Padding="10,6" />
        </WrapPanel>

        <TextBlock Text="{Binding LabsStrings.Snackbars}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
        <WrapPanel Margin="0,0,0,16">
          <Button Content="{Binding LabsStrings.SimpleSnackbar}" Command="{Binding ShowSimpleSnackbarCommand}"
                  Margin="0,0,10,0"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.ActionSnackbar}" Command="{Binding ShowActionSnackbarCommand}"
                  Padding="10,6" />
        </WrapPanel>

        <TextBlock Text="{Binding LabsStrings.Toasts}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
        <WrapPanel Margin="0,0,0,16">
          <Button Content="{Binding LabsStrings.InfoToast}" Command="{Binding ShowInfoToastCommand}" Margin="0,0,10,0"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.SuccessToast}" Command="{Binding ShowSuccessToastCommand}"
                  Margin="0,0,10,0" Padding="10,6" />
          <Button Content="{Binding LabsStrings.ErrorToast}" Command="{Binding ShowErrorToastCommand}" Padding="10,6" />
        </WrapPanel>

        <TextBlock Text="{Binding LabsStrings.Dialogs}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
        <WrapPanel Margin="0,0,0,10">
          <Button Content="{Binding LabsStrings.Alert}" Command="{Binding ShowAlertCommand}" Margin="0,0,10,10"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.Confirm}" Command="{Binding ShowConfirmCommand}" Margin="0,0,10,10"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.DeferrableConfirm}" Command="{Binding ShowDeferrableConfirmCommand}"
                  Margin="0,0,10,10" Padding="10,6" />
          <Button Content="{Binding LabsStrings.CustomOptions}" Command="{Binding ShowCustomOptionsCommand}"
                  Margin="0,0,10,10"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.NestedDialog}" Command="{Binding ShowNestedDialogCommand}"
                  Margin="0,0,10,10" Padding="10,6" />
          <Button Content="{Binding LabsStrings.Mandatory}" Command="{Binding ShowMandatoryDialogCommand}" Margin="0,0,10,10" Padding="10,6" />
          <Button Content="{Binding LabsStrings.NonMandatory}" Command="{Binding ShowNonMandatoryDialogCommand}" Margin="0,0,10,10"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.SelectOption}" Command="{Binding ShowSelectionCommand}"
                  Margin="0,0,10,10" Padding="10,6" />
          <Button Content="{Binding LabsStrings.Wait}" Command="{Binding ShowWaitCommand}" Margin="0,0,10,10"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.GlobalLoading}" Command="{Binding ShowGlobalLoadingCommand}"
                  Margin="0,0,10,10"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.InputNumber}" Command="{Binding ShowNumpadCommand}" Margin="0,0,10,10"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.SignName}" Command="{Binding SignNameCommand}" Margin="0,0,10,10"
                  Padding="10,6" />
          <Button Content="{Binding LabsStrings.PickColor}" Command="{Binding PickColorCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.PickDatetime}" Command="{Binding PickDateTimeCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.PickIpv4}" Command="{Binding PickIpv4Command}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.PreviewImage}" Command="{Binding PreviewImageCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.LeftDrawer}" Command="{Binding ShowLeftDrawerCommand}" Margin="0,0,10,10"
                  Padding="10,6" />
        </WrapPanel>

        <TextBlock Text="{Binding LabsStrings.IcuSectionTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,10" />
        <TextBlock Text="{Binding LabsStrings.IcuSectionDesc}"
                   Foreground="{DynamicResource App.Muted.Foreground}" Margin="0,0,0,10" />

        <TextBlock Text="{Binding LabsStrings.IcuInterpolationLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="{Binding LabsStrings.IcuChangeName}" Command="{Binding ChangeNameCommand}"
                  Margin="0,0,8,0" Padding="10,6" />
          <TextBlock Text="{Binding IcuInterpolationOutput}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>

        <TextBlock Text="{Binding LabsStrings.IcuPluralLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="{Binding LabsStrings.IcuAddItem}" Command="{Binding AddItemCommand}"
                  Margin="0,0,8,0" Padding="10,6" />
          <Button Content="{Binding LabsStrings.IcuRemoveItem}" Command="{Binding RemoveItemCommand}"
                  Margin="0,0,8,0" Padding="10,6" />
          <TextBlock Text="{Binding IcuPluralOutput}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>

        <TextBlock Text="{Binding LabsStrings.IcuSelectLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="{Binding LabsStrings.IcuCycleGender}" Command="{Binding CycleGenderCommand}"
                  Margin="0,0,8,0" Padding="10,6" />
          <TextBlock Text="{Binding IcuSelectOutput}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding LabsStrings.MappingPreview}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />

    <Border Grid.Column="1" Grid.Row="1" BorderBrush="{DynamicResource App.Card.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
              Background="{DynamicResource App.Card.Background}"  VerticalAlignment="Stretch">
      <ScrollViewer VerticalScrollBarVisibility="Auto"  VerticalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding MappingSamples}" />
      </ScrollViewer>
    </Border>
    
  </Grid>
</UserControl>
