<UserControl x:Class="NesterApp.Pages.Labs.VideoPlayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:props="clr-namespace:NesterApp.Properties"
             xmlns:vm="clr-namespace:NesterApp.Pages.Labs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VideoPlayerPageModel}"
             d:DesignHeight="450" d:DesignWidth="800">

  <UserControl.Resources>
    <StreamGeometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
  </UserControl.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding VideoTitle}" FontSize="24" FontWeight="Bold" />

    <!--
      Mock stage.  A real app hosts a native VideoView here; the point of the
      page is the lifecycle demo — navigate away and the playback hands over
      to the floating player (OnDeparted → FloatingPlayerHost).
    -->
    <Border Grid.Row="1" Margin="0,12" CornerRadius="10" Background="#FF0E1015" MinHeight="220">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Path Data="{StaticResource IconPlay}" Fill="#66FFFFFF" Width="44" Height="44" Stretch="Uniform" />
        <TextBlock Text="{Binding Source={x:Static props:Lang.Labs}, Path=NowPlaying}"
                   Foreground="#CCFFFFFF" FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,12,0,0" />
        <TextBlock Text="{Binding VideoTitle}" Foreground="#80FFFFFF" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ProgressBar Value="{Binding PlaybackPosition}" Maximum="100" Height="4" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                 Foreground="{DynamicResource App.Muted.Foreground}"
                 Text="{Binding PlaybackPosition, StringFormat='{}{0:0.0}s'}" />
    </Grid>
  </Grid>
</UserControl>
