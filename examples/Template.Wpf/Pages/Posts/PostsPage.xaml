<UserControl x:Class="NesterApp.Pages.Posts.PostsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:NesterApp.Pages.Posts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:PostsPageModel}"
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding PagesStrings.PostsTitle}" FontSize="24" Margin="10" FontWeight="Bold" />

    <ScrollViewer Grid.Row="1" Margin="10">
      <ItemsControl x:Name="PostList" ItemsSource="{Binding Posts}"
                    HorizontalAlignment="Center" MaxWidth="500">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource App.Card.Background}" CornerRadius="6" Margin="0,4" Padding="12"
                    BorderBrush="{DynamicResource App.Card.BorderBrush}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                <Button
                  Content="{Binding DataContext.PagesStrings.ViewDetail,
                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  HorizontalAlignment="Right"
                  Command="{Binding DataContext.OpenPostCommand,
                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}" Margin="0,5,0,0" />
                <Button
                  Content="{Binding DataContext.PagesStrings.OpenInFloat,
                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  HorizontalAlignment="Right"
                  Command="{Binding DataContext.OpenInDialogCommand,
                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
