<!-- ReSharper disable once ObsoleteElementError -->
<Application x:Class="NesterApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:m="clr-namespace:NesterApp.Models"
             ThemeMode="System">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Everlong.Nester.Wpf;component/Themes/Generic.xaml" />
        <!-- The Extensions dialog chrome (dimmer + dialog surfaces) is theme-driven
             from its own package — merge next to the core theme. -->
        <ResourceDictionary Source="pack://application:,,,/Everlong.Nester.Extensions.Wpf;component/Themes/NesterExtendedTheme.xaml" />
        <!--
          Fluent is NOT merged here: ThemeMode above loads the Fluent theme
          dictionary itself, and a manual merge would shadow it — the app would
          stay in System/Light regardless of ThemeMode.
        -->
        <ResourceDictionary Source="Assets/AppResources.xaml" />
        <!-- The rest of the Model→View translation table is registered in code
             inside App.xaml.cs/OnStartup so the bootstrap flow is visible in
             one place; leaf item views are declared below. -->
      </ResourceDictionary.MergedDictionaries>

      <!--
        EmojiIcon — an app-level leaf view.  The implicit template keyed by type
        is exactly what the ContentPresenter inside RouteLink/RouteTreeItem
        looks up, so this declaration is the whole translation.  Declaring it
        here rather than as a locator entry is not a style choice: dynamic
        locating can only build a control (a FrameworkElementFactory of
        ImperativeContentControl), which costs every icon one ContentControl
        plus that control's own ContentPresenter.  A plain DataTemplate has no
        wrapper.

        emoji:TextBlock composites Segoe UI Emoji's COLR/CPAL layers; WPF's own
        TextBlock would paint the monochrome fallback outlines only.  The
        default ColorBlend="False" keeps the glyph's own colors — turning it on
        tints the emoji towards Foreground instead.
      -->
      <DataTemplate DataType="{x:Type m:EmojiIcon}">
        <emoji:TextBlock Text="{Binding Glyph}" />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
