<UserControl x:Class="NesterApp.Dialogs.LeftDrawerDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:props="clr-namespace:NesterApp.Properties"
             xmlns:vm="clr-namespace:NesterApp.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LeftDrawerDialogSession}"
             d:DesignHeight="400" d:DesignWidth="320"
             Width="320" HorizontalAlignment="Left" VerticalAlignment="Stretch">
  <!-- Width is the drawer's own business; VerticalAlignment=Stretch makes
       its height match the shell (the dimmer slot is full-stage). -->
  <Border Background="{DynamicResource Nester.DialogChrome.Background}"
          BorderBrush="{DynamicResource Nester.Border}"
          BorderThickness="1"
          CornerRadius="0,10,10,0"
          Padding="28">
    <StackPanel>
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="{Binding Source={x:Static props:Lang.Labs}, Path=LeftDrawerBody1}"
                 TextWrapping="Wrap" Margin="0,14,0,0" />
      <TextBlock Text="{Binding Source={x:Static props:Lang.Labs}, Path=LeftDrawerBody2}"
                 TextWrapping="Wrap" Margin="0,14,0,0" />
    </StackPanel>
  </Border>
</UserControl>
