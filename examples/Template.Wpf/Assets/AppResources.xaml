<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    App-level resource dictionary for NesterApp (WPF).

    OVERVIEW
    ────────
    Two sections live here:

      1. App.* tokens  — active brush resources used throughout this template.
         Apply them with {DynamicResource App.Page.Background} etc.

      2. Nester.* overrides  — commented-out copies of every overridable
         Nester built-in color key.  Uncomment any entry to customise
         Nester's components (dialogs, toasts, nav links, …) without
         touching the library source.

    HOW OVERRIDES WORK
    ──────────────────
    AppResources.xaml is merged AFTER the core Generic.xaml and the Extensions NesterExtendedTheme.xaml in App.xaml.
    WPF's DynamicResource lookup honours the last-merged definition,
    so any key you redefine here will silently win over the built-in default.

    DARK MODE
    ─────────
    App.xaml sets ThemeMode and the shell's WpfThemeService drives it, so
    WPF's Fluent controls adapt at runtime.  WPF has no ThemeDictionaries,
    so the palettes swap explicitly: the service merges
    Assets/AppResources.Dark.xaml over the App.* brushes below and calls
    NesterTheme.UseDark / NesterExtendedTheme.UseDark for Nester's chrome
    (Themes/Colors.Dark.xaml, NesterExtendedTheme.Dark.xaml).  Add a dark
    value to AppResources.Dark.xaml whenever you add an App.* brush here.
  -->

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!--  App tokens (active, light-mode)                                   -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="App.Sidebar.Background" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="App.Sidebar.Border" Color="#1A000000" />
  <SolidColorBrush x:Key="App.Body.BorderBrush" Color="#10000000" />
  <SolidColorBrush x:Key="App.Muted.Foreground" Color="#6B7280" />
  <SolidColorBrush x:Key="App.Card.Background" Color="#CCFFFFFF" />
  <SolidColorBrush x:Key="App.Card.BorderBrush" Color="#10000000" />
  <SolidColorBrush x:Key="App.Admin.Background" Color="#FFF4CE" />
  <SolidColorBrush x:Key="App.Admin.BorderBrush" Color="#FFD700" />
  <SolidColorBrush x:Key="App.Admin.Foreground" Color="#1B2130" />
  <SolidColorBrush x:Key="App.Danger.Foreground" Color="#DC2626" />
  <SolidColorBrush x:Key="App.Danger.Hover.Background" Color="#FEE2E2" />

