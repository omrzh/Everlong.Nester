  </ResourceDictionary.ThemeDictionaries>

  <!-- ─────────────────────────────────────────────────────────────────── -->
  <!--  Brushes — auto-adapt to the active theme via DynamicResource       -->
  <!-- ─────────────────────────────────────────────────────────────────── -->

  <SolidColorBrush x:Key="App.Card.Background"                Color="{DynamicResource App.Color.Card.Background}" />
  <SolidColorBrush x:Key="App.Card.BorderBrush"               Color="{DynamicResource App.Color.Card.BorderBrush}" />
  <SolidColorBrush x:Key="App.Sidebar.Background"             Color="{DynamicResource App.Color.Sidebar.Background}" />
  <SolidColorBrush x:Key="App.Sidebar.Border"                 Color="{DynamicResource App.Color.Sidebar.Border}" />
  <SolidColorBrush x:Key="App.Body.Background"                Color="Transparent" />
  <SolidColorBrush x:Key="App.Body.BorderBrush"               Color="{DynamicResource App.Color.Body.BorderBrush}" />
  <SolidColorBrush x:Key="App.Window.Background"              Color="{DynamicResource App.Color.Window.Background}" />
  <SolidColorBrush x:Key="App.Muted.Foreground"               Color="{DynamicResource App.Color.Muted.Foreground}" />
  <SolidColorBrush x:Key="App.TitleBar.Foreground"            Color="{DynamicResource App.Color.TitleBar.Foreground}" />
  <SolidColorBrush x:Key="App.TitleBar.Hover.Background"      Color="{DynamicResource App.Color.TitleBar.Hover.Background}" />
  <SolidColorBrush x:Key="App.TitleBar.Pressed.Background"    Color="{DynamicResource App.Color.TitleBar.Pressed.Background}" />
  <SolidColorBrush x:Key="App.Caption.Hover.Background"       Color="{DynamicResource App.Color.Caption.Hover.Background}" />
  <SolidColorBrush x:Key="App.Caption.Pressed.Background"     Color="{DynamicResource App.Color.Caption.Pressed.Background}" />
  <SolidColorBrush x:Key="App.Caption.Close.Hover.Background" Color="{DynamicResource App.Color.Caption.Close.Hover.Background}" />
  <SolidColorBrush x:Key="App.Panel.Background"               Color="{DynamicResource App.Color.Panel.Background}" />
  <SolidColorBrush x:Key="App.Panel.BorderBrush"              Color="{DynamicResource App.Color.Panel.BorderBrush}" />
  <SolidColorBrush x:Key="App.Panel.Foreground"               Color="{DynamicResource App.Color.Panel.Foreground}" />
  <SolidColorBrush x:Key="App.Panel.Muted"                    Color="{DynamicResource App.Color.Panel.Muted}" />
  <SolidColorBrush x:Key="App.Panel.Graph.Surface"            Color="{DynamicResource App.Color.Panel.Graph.Surface}" />
  <SolidColorBrush x:Key="App.Panel.Graph.Guide"              Color="{DynamicResource App.Color.Panel.Graph.Guide}" />
  <SolidColorBrush x:Key="App.Panel.Graph.Line"               Color="{DynamicResource App.Color.Panel.Graph.Line}" />
  <SolidColorBrush x:Key="App.Admin.Background"               Color="{DynamicResource App.Color.Admin.Background}" />
  <SolidColorBrush x:Key="App.Admin.BorderBrush"              Color="{DynamicResource App.Color.Admin.BorderBrush}" />
  <SolidColorBrush x:Key="App.Admin.Foreground"               Color="{DynamicResource App.Color.Admin.Foreground}" />
  <SolidColorBrush x:Key="App.Danger.Foreground"              Color="{DynamicResource App.Color.Danger.Foreground}" />
  <SolidColorBrush x:Key="App.Danger.Hover.Background"        Color="{DynamicResource App.Color.Danger.Hover.Background}" />
  <SolidColorBrush x:Key="App.Danger.Button"                  Color="{DynamicResource App.Color.Danger.Button}" />
  <SolidColorBrush x:Key="App.Danger.Button.Hover"            Color="{DynamicResource App.Color.Danger.Button.Hover}" />
  <SolidColorBrush x:Key="App.Danger.Button.Pressed"          Color="{DynamicResource App.Color.Danger.Button.Pressed}" />
</ResourceDictionary>
