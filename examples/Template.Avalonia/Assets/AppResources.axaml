      <Color x:Key="App.Color.Card.Background">#CC1C1C1C</Color>
      <Color x:Key="App.Color.Card.BorderBrush">#18FFFFFF</Color>
      <Color x:Key="App.Color.Sidebar.Background">#0AFFFFFF</Color>
      <Color x:Key="App.Color.Sidebar.Border">#26FFFFFF</Color>
