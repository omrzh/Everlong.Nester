<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    App-level resource dictionary for NesterApp.

    OVERVIEW
    ────────
    Two sections live here:

      1. App.* tokens  — active color tokens used throughout this template.
         Apply them with {DynamicResource App.Page.Background} etc.

      2. Nester.* overrides  — commented-out copies of every overridable
         Nester built-in color key.  Uncomment any entry (in both Light and
         Dark variants) to customize Nester's components (dialogs, toasts,
         nav links, …) without touching the library source.

    HOW OVERRIDES WORK
    ──────────────────
    AppResources.axaml is merged AFTER the core NesterTheme.axaml and the Extensions NesterExtendedTheme.axaml in App.axaml.
    Avalonia's DynamicResource lookup honors the last-merged definition,
    so any key you redefine here will silently win over the built-in default.
    Light/Dark variants inside ThemeDictionaries have higher priority than
    the same key declared outside, so per-theme overrides work correctly.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  LIGHT THEME                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ResourceDictionary x:Key="Light">

      <!-- ── App tokens (active) ─────────────────────────────────── -->

      <Color x:Key="App.Color.Card.Background">#CCFFFFFF</Color>
      <Color x:Key="App.Color.Card.BorderBrush">#10000000</Color>
      <Color x:Key="App.Color.Body.BorderBrush">#E0E0E0</Color>
      <Color x:Key="App.Color.Sidebar.Background">#0AFFFFFF</Color>
      <Color x:Key="App.Color.Sidebar.Border">#1A000000</Color>
      <Color x:Key="App.Color.TitleBar.Foreground">#1B2130</Color>
      <Color x:Key="App.Color.TitleBar.Hover.Background">#14000000</Color>
      <Color x:Key="App.Color.TitleBar.Pressed.Background">#24000000</Color>
      <Color x:Key="App.Color.Caption.Hover.Background">#14000000</Color>
      <Color x:Key="App.Color.Caption.Pressed.Background">#24000000</Color>
      <Color x:Key="App.Color.Caption.Close.Hover.Background">#C42B1C</Color>
      <Color x:Key="App.Color.Muted.Foreground">#6B7280</Color>
      <Color x:Key="App.Color.Window.Background">#F7FAFF</Color>
      <Color x:Key="App.Color.Panel.Background">#F7FFFFFF</Color>
      <Color x:Key="App.Color.Panel.BorderBrush">#1A000000</Color>
      <Color x:Key="App.Color.Panel.Foreground">#1B2130</Color>
      <Color x:Key="App.Color.Panel.Muted">#6B7280</Color>
      <Color x:Key="App.Color.Panel.Graph.Surface">#EDF1F8</Color>
      <Color x:Key="App.Color.Panel.Graph.Guide">#C3CCDC</Color>
      <Color x:Key="App.Color.Panel.Graph.Line">#0A84D8</Color>
      <Color x:Key="App.Color.Admin.Background">#FFF4CE</Color>
      <Color x:Key="App.Color.Admin.BorderBrush">#FFD700</Color>
      <Color x:Key="App.Color.Admin.Foreground">#1B2130</Color>
      <Color x:Key="App.Color.Danger.Foreground">#DC2626</Color>
      <Color x:Key="App.Color.Danger.Hover.Background">#FEE2E2</Color>
      <Color x:Key="App.Color.Danger.Button">#DC2626</Color>
      <Color x:Key="App.Color.Danger.Button.Hover">#B91C1C</Color>
      <Color x:Key="App.Color.Danger.Button.Pressed">#991B1B</Color>

      <!-- ── Nester built-in overrides (commented — uncomment to customize) ── -->

      <!-- Brand / Primary -->
      <!--<Color x:Key="Nester.Color.Brand">#0078D4</Color>-->
      <!--<Color x:Key="Nester.Color.Brand.Hover">#106EBE</Color>-->
      <!--<Color x:Key="Nester.Color.Brand.Pressed">#005A9E</Color>-->
      <!--<Color x:Key="Nester.Color.Brand.Selected">#106EBE</Color>-->

      <!-- Border -->
      <!--<Color x:Key="Nester.Color.Border">#E0E0E0</Color>-->

      <!-- Dialog chrome -->
      <!--<Color x:Key="Nester.Color.DialogChrome.Background">#FFFFFF</Color>-->
      <!--<Color x:Key="Nester.Color.DialogChrome.Foreground">#212121</Color>-->

      <!-- Toast -->
      <!--<Color x:Key="Nester.Color.Toast.Background">#FFFFFF</Color>-->
      <!--<Color x:Key="Nester.Color.Toast.Foreground">#212121</Color>-->

      <!-- Snackbar -->
      <!--<Color x:Key="Nester.Color.Snackbar.Background">#FFFFFF</Color>-->
      <!--<Color x:Key="Nester.Color.Snackbar.Foreground">#212121</Color>-->
      <!--<Color x:Key="Nester.Color.Snackbar.Action">#FF4081</Color>-->

      <!-- Semantic status -->
      <!--<Color x:Key="Nester.Color.Success">#4CAF50</Color>-->
      <!--<Color x:Key="Nester.Color.Error">#F44336</Color>-->
      <!--<Color x:Key="Nester.Color.Warning">#FF9800</Color>-->
      <!--<Color x:Key="Nester.Color.Info">#2196F3</Color>-->

      <!-- RouteLink -->
      <!--<Color x:Key="Nester.Color.RouteLink.Hover">#F0F0F0</Color>-->
      <!--<Color x:Key="Nester.Color.RouteLink.Active.Background">#1A000000</Color>-->
      <!--<Color x:Key="Nester.Color.RouteLink.Active.Foreground">#0078D7</Color>-->

      <!-- RouteTreeItem -->
      <!--<Color x:Key="Nester.Color.RouteTreeItem.Hover">#F0F0F0</Color>-->
      <!--<Color x:Key="Nester.Color.RouteTreeItem.Selected.Background">#1A000000</Color>-->
      <!--<Color x:Key="Nester.Color.RouteTreeItem.Selected.Background.Light">#07000000</Color>-->
      <!--<Color x:Key="Nester.Color.RouteTreeItem.Active.Foreground">#0078D7</Color>-->

      <!-- TreeItem / Notice -->
      <!--<Color x:Key="Nester.Color.TreeItem.Hover">#F0F0F0</Color>-->
      <!--<Color x:Key="Nester.Color.Notice.Hover">#F0F0F0</Color>-->

      <!-- Dimmer backdrop -->
      <!--<Color x:Key="Nester.Color.Dimmer.Backdrop">#40000000</Color>-->

    </ResourceDictionary>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  DARK THEME                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ResourceDictionary x:Key="Dark">

