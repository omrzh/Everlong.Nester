      <Color x:Key="App.Color.TitleBar.Hover.Background">#1AFFFFFF</Color>
      <Color x:Key="App.Color.TitleBar.Pressed.Background">#2EFFFFFF</Color>
      <Color x:Key="App.Color.Caption.Hover.Background">#1AFFFFFF</Color>
      <Color x:Key="App.Color.Caption.Pressed.Background">#2EFFFFFF</Color>
      <Color x:Key="App.Color.Caption.Close.Hover.Background">#C42B1C</Color>
