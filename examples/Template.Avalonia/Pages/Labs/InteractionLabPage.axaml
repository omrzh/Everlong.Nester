<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NesterApp.Pages.Labs"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="NesterApp.Pages.Labs.InteractionLabPage"
             x:DataType="vm:InteractionLabPageModel">
  <Grid ColumnDefinitions="3*,2*" RowDefinitions="Auto,*" Margin="20">
    <TextBlock Grid.Column="0" Grid.Row="0" Classes="pageTitle" Text="{Binding LabsStrings.InteractionLabTitle}" Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
      <StackPanel Spacing="12">
        <TextBlock Classes="pageSubtitle" Text="{Binding LabsStrings.InteractionLabSubtitle}" Margin="0,0,0,20" />

        <TextBlock Classes="sectionHeader" Text="{Binding LabsStrings.Notifications}" />
        <WrapPanel>
          <Button Content="{Binding LabsStrings.Info}" Command="{Binding ShowInfoNotificationCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.Success}" Command="{Binding ShowSuccessNotificationCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.Warning}" Command="{Binding ShowWarningNotificationCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.Error}" Command="{Binding ShowErrorNotificationCommand}"
                  Margin="0,0,10,10" />
        </WrapPanel>

        <TextBlock Classes="sectionHeader" Text="{Binding LabsStrings.Snackbars}" />
        <WrapPanel>
          <Button Content="{Binding LabsStrings.SimpleSnackbar}" Command="{Binding ShowSimpleSnackbarCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.ActionSnackbar}" Command="{Binding ShowActionSnackbarCommand}"
                  Margin="0,0,10,10" />
        </WrapPanel>

        <TextBlock Classes="sectionHeader" Text="{Binding LabsStrings.Toasts}" />
        <WrapPanel>
          <Button Content="{Binding LabsStrings.InfoToast}" Command="{Binding ShowInfoToastCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.SuccessToast}" Command="{Binding ShowSuccessToastCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.ErrorToast}" Command="{Binding ShowErrorToastCommand}"
                  Margin="0,0,10,10" />
        </WrapPanel>

        <TextBlock Classes="sectionHeader" Text="{Binding LabsStrings.Dialogs}" />
        <WrapPanel>
          <Button Content="{Binding LabsStrings.Alert}" Command="{Binding ShowAlertCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.Confirm}" Command="{Binding ShowConfirmCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.DeferrableConfirm}" Command="{Binding ShowDeferrableConfirmCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.CustomOptions}" Command="{Binding ShowCustomOptionsCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.NestedDialog}" Command="{Binding ShowNestedDialogCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.Mandatory}" Command="{Binding ShowMandatoryDialogCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.NonMandatory}" Command="{Binding ShowNonMandatoryDialogCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.SelectOption}" Command="{Binding ShowSelectionCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.Wait}" Command="{Binding ShowWaitCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.GlobalLoading}" Command="{Binding ShowGlobalLoadingCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.InputNumber}" Command="{Binding ShowNumpadCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.SignName}" Command="{Binding SignNameCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.PickColor}" Command="{Binding PickColorCommand}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.PickDatetime}" Command="{Binding PickDateTimeCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.PickIpv4}" Command="{Binding PickIpv4Command}" Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.PreviewImage}" Command="{Binding PreviewImageCommand}"
                  Margin="0,0,10,10" />
          <Button Content="{Binding LabsStrings.LeftDrawer}" Command="{Binding ShowLeftDrawerCommand}" Margin="0,0,10,10" />
        </WrapPanel>

        <TextBlock Classes="sectionHeader" Text="{Binding LabsStrings.IcuSectionTitle}" />
        <TextBlock Classes="pageSubtitle" Text="{Binding LabsStrings.IcuSectionDesc}" />

        <TextBlock Text="{Binding LabsStrings.IcuInterpolationLabel}" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{Binding LabsStrings.IcuChangeName}" Command="{Binding ChangeNameCommand}" />
          <TextBlock Text="{Binding IcuInterpolationOutput}" VerticalAlignment="Center"
                     FontWeight="SemiBold" />
        </StackPanel>

        <TextBlock Text="{Binding LabsStrings.IcuPluralLabel}" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{Binding LabsStrings.IcuAddItem}" Command="{Binding AddItemCommand}" />
          <Button Content="{Binding LabsStrings.IcuRemoveItem}" Command="{Binding RemoveItemCommand}" />
          <TextBlock Text="{Binding IcuPluralOutput}" VerticalAlignment="Center"
                     FontWeight="SemiBold" />
        </StackPanel>

        <TextBlock Text="{Binding LabsStrings.IcuSelectLabel}" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{Binding LabsStrings.IcuCycleGender}" Command="{Binding CycleGenderCommand}" />
          <TextBlock Text="{Binding IcuSelectOutput}" VerticalAlignment="Center"
                     FontWeight="SemiBold" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>


    <TextBlock Grid.Row="0" Grid.Column="1" Classes="sectionHeader" Text="{Binding LabsStrings.MappingPreview}" Margin="0,0,0,10" />

    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource App.Card.BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Stretch"
            Background="{DynamicResource App.Card.Background}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding MappingSamples}" />
      </ScrollViewer>
    </Border>

  </Grid>
</UserControl>
