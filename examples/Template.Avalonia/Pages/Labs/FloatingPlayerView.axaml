<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="using:NesterApp.Pages.Labs"
             mc:Ignorable="d"
             x:Class="NesterApp.Pages.Labs.FloatingPlayerView"
             x:DataType="l:FloatingPlayerViewModel"
             d:DesignHeight="180" d:DesignWidth="320">

  <UserControl.Styles>
    <!--
      Hover must be declared on the template child: a local Background on the
      Button outranks a :pointerover setter on the Button itself (Avalonia's
      LocalValue > StyleTrigger), so a button-level style would never fire.
    -->
    <Style Selector="Button.floatingClose">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Surface" Background="{TemplateBinding Background}" CornerRadius="12">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.floatingClose:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.floatingClose:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="#55FFFFFF" />
    </Style>
  </UserControl.Styles>

  <!-- No background: the root control does not participate in hit-testing; only the card itself is interactive. -->
  <Border x:Name="DraggableCard"
          Width="320" Height="180"
          HorizontalAlignment="Left" VerticalAlignment="Top"
          Margin="32,32,0,0"
          Background="#F01E1E1E"
          BorderBrush="#33FFFFFF"
          BorderThickness="1"
          CornerRadius="12"
          Cursor="SizeAll"
          BoxShadow="0 6 24 0 #80000000"
          PointerPressed="OnDragStart"
          PointerMoved="OnDragMove"
          PointerReleased="OnDragEnd">
    <Grid Margin="12" RowDefinitions="Auto,*,Auto">

      <!-- Title row + close -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="#FF4CAF50" Margin="0,0,8,0" />
          <TextBlock Text="{Binding VideoTitle}"
                     Foreground="White" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Classes="floatingClose"
                Command="{Binding CloseCommand}">
          <Path Data="M 2,2 L 14,14 M 14,2 L 2,14"
                Stroke="White" StrokeThickness="1.4"
                StrokeLineCap="Round"
                Width="16" Height="16" />
        </Button>
      </Grid>

      <!-- Playback status -->
      <TextBlock Grid.Row="1"
                 Text="{Binding NowPlaying}" Foreground="#99FFFFFF"
                 VerticalAlignment="Center" />

      <!-- Progress -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
        <ProgressBar Value="{Binding PlaybackPosition}" Maximum="100"
                     Height="4" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding PlaybackPosition, StringFormat={}{0:0.0}s}"
                   Foreground="#99FFFFFF" FontSize="11" Margin="8,0,0,0" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
