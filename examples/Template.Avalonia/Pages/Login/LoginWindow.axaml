<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:NesterApp.Pages.Login"
        xmlns:props="using:NesterApp.Properties"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="360"
        Width="420" Height="360"  WindowStartupLocation="CenterScreen"
        x:Class="NesterApp.Pages.Login.LoginWindow"
        x:DataType="local:LoginWindowModel"
        Title="{Binding LoginStrings.Title}">

  <Window.Styles>
    <Style Selector="Button.dialogClose">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource App.Panel.Foreground}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Surface" Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.dialogClose:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource App.Caption.Hover.Background}" />
    </Style>
    <Style Selector="Button.dialogClose:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource App.Caption.Pressed.Background}" />
    </Style>
  </Window.Styles>

  <Border x:Name="RootBorder" CornerRadius="8" ClipToBounds="True"
          Background="{DynamicResource Nester.DialogChrome.Background}"
          PointerPressed="OnDragMove">
    <Grid>
      <ContentControl x:Name="RootSlot" />
      <Button x:Name="CloseButton" Classes="dialogClose"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,6,6,0"
              Command="{Binding CloseCommand}"
              ToolTip.Tip="{Binding Source={x:Static props:Lang.Navigation}, Path=Close}">
        <PathIcon Data="{DynamicResource Nester.Icon.Dismiss}" Width="12" Height="12"
                  Foreground="{Binding $parent[Button].Foreground}" />
      </Button>
    </Grid>
  </Border>
</Window>
