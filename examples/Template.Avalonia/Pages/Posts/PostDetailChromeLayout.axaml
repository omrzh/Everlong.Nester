<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:n="https://nester.dev"
             xmlns:props="using:NesterApp.Properties"
             xmlns:vm="using:NesterApp.Pages.Posts"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="NesterApp.Pages.Posts.PostDetailChromeLayout"
             x:DataType="vm:PostDetailChromeLayoutModel">

  <!-- Floating panel chrome: centered card hosting the overlay content. -->
  <Grid>
    <Border Background="{DynamicResource App.Card.Background}"
            BorderBrush="{DynamicResource App.Card.BorderBrush}"
            BorderThickness="1" CornerRadius="16" BoxShadow="0 8 24 0 #33000000"
            Width="720" MaxHeight="620"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid RowDefinitions="Auto,*">

        <!-- Panel header -->
        <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,12"
                Background="{DynamicResource App.Sidebar.Background}">
          <TextBlock Text="{Binding Source={x:Static props:Lang.Pages}, Path=PostDetailChromeTitle}"
                     FontSize="16" FontWeight="SemiBold" />
        </Border>

        <!-- Overlay content mount point -->
        <n:LayoutBody x:Name="Body" Grid.Row="1" Margin="0,4,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
