<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NesterApp.App"
             RequestedThemeVariant="Default">
  <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
  <!--
    NOTE: the Model→View translation table is NOT declared here — it is
    registered in code inside App.axaml.cs/Initialize() so the bootstrap
    flow is visible in one place.
  -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="Assets/AppResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <StyleInclude Source="avares://Everlong.Nester.Avalonia/Themes/NesterTheme.axaml" />
    <!-- The Extensions dialog chrome (dimmer + dialog surfaces) is theme-driven
         from its own package — merge next to the core theme. -->
    <StyleInclude Source="avares://Everlong.Nester.Extensions.Avalonia/Themes/NesterExtendedTheme.axaml" />
    <FluentTheme />

    <!--
      Page-level type scale — the single source of truth for demo-page
      headings.  Declared after FluentTheme so these win where they overlap.
      Usage: <TextBlock Classes="pageTitle" Text="..." />
    -->
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="Foreground" Value="{DynamicResource App.Muted.Foreground}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Styles>
</Application>
