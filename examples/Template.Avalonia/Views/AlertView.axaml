<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:NesterApp.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NesterApp.Views.AlertView"
             x:DataType="m:AlertMessage">
  <Border BorderBrush="{DynamicResource Nester.Error}" BorderThickness="2" Background="{DynamicResource App.Card.Background}" Padding="10" Margin="5" CornerRadius="5">
    <StackPanel>
      <TextBlock Text="{Binding Severity}" Foreground="{DynamicResource Nester.Error}" FontWeight="Bold" />
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
