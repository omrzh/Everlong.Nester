<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:NesterApp.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NesterApp.Views.TextView"
             x:DataType="m:TextMessage">
  <Border Background="{DynamicResource App.Card.Background}"
          BorderBrush="{DynamicResource Nester.Info}" BorderThickness="1"
          Padding="10" Margin="5" CornerRadius="6">
    <TextBlock Text="{Binding Content}" FontSize="16" />
  </Border>
</UserControl>